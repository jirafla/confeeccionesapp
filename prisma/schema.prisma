generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Empresa {
  id          String    @id @default(cuid())
  nombre      String
  nit         String?   
  
  usuarios     Usuario[]
  invitaciones Invitacion[]
  talleres     Taller[]
  clientes     Cliente[]
  referencias  Referencia[]
  ordenes      OrdenProduccion[]
  asignaciones Asignacion[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Usuario {
  id          String   @id 
  email       String   @unique
  nombre      String?
  rol         String   @default("ADMIN") 
  
  empresaId   String
  empresa     Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Invitacion {
  id        String   @id @default(cuid())
  token     String   @unique @default(cuid())
  email     String
  nombre    String?
  rol       String   @default("OPERADOR") // ADMIN, SUPERVISOR, OPERADOR
  estado    String   @default("PENDIENTE") // PENDIENTE, ACEPTADA, REVOCADA
  
  empresaId String
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Taller {
  id        String   @id @default(cuid())
  nombre    String
  telefono  String?
  direccion String?
  asignaciones Asignacion[]
  
  empresaId String
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Cliente {
  id        String   @id @default(cuid())
  nombre    String
  telefono  String?
  
  empresaId String
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  ordenes   OrdenProduccion[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Referencia {
  id                String   @id @default(cuid())
  codigo            String   
  nombrePrenda      String?  // Ej. "Vestido con cuello"
  telasDetalles     String?  // JSON con lista de telas: [{ nombre: "Tela 1", tipo: "Malla", promedio: 0.57 }]
  insumosDetalles   String?  // JSON con lista de insumos
  disenoArchivoUrl  String? 
  optitexArchivoUrl String? 
  
  empresaId         String
  empresa           Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  ordenes           OrdenProduccion[]
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model OrdenProduccion {
  id                String   @id @default(cuid())
  consecutivo       Int      @default(1) // Nro. de orden dentro de la referencia: 5370-1, 5370-2...
  cantidadTotal     Int
  coloresDetalles   String?
  insumosColores    String?
  estado            String   @default("CORTE") // CORTE, CONFECCION, ENTREGADO
  precioCorte       Float?
  observacionesCorte String?
  fechaEntregado    DateTime?
  costosMateriales  String?

  clienteId         String
  cliente           Cliente    @relation(fields: [clienteId], references: [id])
  referenciaId      String
  referencia        Referencia @relation(fields: [referenciaId], references: [id])
  
  empresaId         String
  empresa           Empresa    @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  
  asignaciones      Asignacion[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Asignacion {
  id                String   @id @default(cuid())
  cantidadAsignada  Int
  precioUnitario    Float
  insumosEntregados String?
  fechaEnvio        DateTime
  fechaEntregaEsperada DateTime
  
  cantidadBuena     Int?     @default(0)
  reprocesos        Int?     @default(0)
  estadoLote        String   @default("ASIGNADO") // ASIGNADO, ENTREGADO
  estadoPago        String   @default("PENDIENTE") // PENDIENTE, PAGADO

  esReproceso       Boolean  @default(false)
  descuentoReproceso Float?  @default(0)
  notasReproceso    String?

  ordenId           String
  orden             OrdenProduccion @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  tallerId          String
  taller            Taller          @relation(fields: [tallerId], references: [id])
  
  empresaId         String
  empresa           Empresa         @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  
  abonos            Abono[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Abono {
  id           String   @id @default(cuid())
  monto        Float
  fecha        DateTime @default(now())
  nota         String?
  
  asignacionId String
  asignacion   Asignacion @relation(fields: [asignacionId], references: [id], onDelete: Cascade)
  
  createdAt    DateTime @default(now())
}
